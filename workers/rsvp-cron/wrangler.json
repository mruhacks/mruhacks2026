{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mruhacks-rsvp-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "APP_URLS": "https://REPLACE-WITH-PRODUCTION-ORIGIN,https://REPLACE-WITH-TEST-ORIGIN"
  },
  "observability": {
    "enabled": true
  }
}

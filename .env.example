BETTER_AUTH_SECRET=1188f06ccc692323a265793362bd0836862794f3f3c9c0282b2979dbd31d1e7b
# Public origin of the app as users open it in the browser (scheme, host, port). Better Auth uses
# BETTER_AUTH_URL for links in verification and password-reset emails; it must match this origin
# (e.g. if you use `next dev` on port 3000, keep http://localhost:3000; change the port if yours differs).
BETTER_AUTH_URL=http://localhost:3000

# Optional: explicit origin for the Better Auth browser client (e.g. sendVerificationEmail).
# Use the same URL as BETTER_AUTH_URL when the app and API share one origin (typical Next.js).
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

## ── SMTP (local dev: MailHog via docker compose; see mailhog service) ─────────
# MailHog does not use SMTP auth—leave SMTP_USER and SMTP_PASSWORD empty for local development.
# Web UI: http://localhost:8025 — SMTP from the host: localhost:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MRU Hacks <noreply@localhost>


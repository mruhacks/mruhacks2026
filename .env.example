# NOTICE
#
# The following values are EXAMPLES ONLY.
# They are not secure, not unique, and must never be used in production.
#
# Using these secrets in a live environment could expose your database,
# authentication system, or user data to serious security risks.
#
# Always generate fresh secrets using a secure random generator, for example:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#   or
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).rstrip(b'=').decode())"
#
# Replace all example credentials below before deploying to any public system.
################################################################################

BETTER_AUTH_SECRET=1188f06ccc692323a265793362bd0836862794f3f3c9c0282b2979dbd31d1e7b
BETTER_AUTH_URL=http://localhost:3000

## ── SMTP (local dev: MailHog via docker compose; see mailhog service) ─────────
# MailHog does not use SMTP auth—leave SMTP_USER and SMTP_PASSWORD empty for local development.
# Web UI: http://localhost:8025 — SMTP from the host: localhost:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MRU Hacks <noreply@localhost>
# MailHog API URL (used for testing email integration)
MAILHOG_API_URL=http://localhost:8025/api

## ── Object storage (local dev: MinIO, S3-compatible) ──────────────────────
# Production can point these at AWS S3, Cloudflare R2, or another S3-compatible
# object store. The application keeps resumes private (proxied, auth-checked
# on every request) and profile pictures public (unguessable key).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mruhacks-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PORT=9000
S3_CONSOLE_PORT=9001



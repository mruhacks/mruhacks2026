#

# ── SEED ADMIN USER ──────────────────────────────
# When set, the seed script creates (or recreates) a login-ready admin user
# with the 'admin' role. Useful for local dev and CI. Omit in production.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme
# SEED_ADMIN_NAME=Admin          # optional, defaults to "Admin"

## ── Cloudflare Turnstile (bot protection: sign-in, sign-up, magic link, password reset) ──
# Real keys come from the Cloudflare dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# The pair below is Cloudflare's published "always passes" test pair — works on any domain,
# including localhost, with no Cloudflare account needed. Replace both before deploying anywhere
# public. Other test sitekeys, for exercising specific flows locally:
#   1x00000000000000000000AA  always passes   (visible)
#   2x00000000000000000000AB  always fails    (visible)
#   1x00000000000000000000BB  always passes   (invisible)
#   2x00000000000000000000BB  always fails    (invisible)
#   3x00000000000000000000FF  forces an interactive challenge
# ...paired with the matching test secret key:
#   1x0000000000000000000000000000000AA  always passes validation
#   2x0000000000000000000000000000000AA  always fails validation
#   3x0000000000000000000000000000000AA  "token already spent" error
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

## ── Health check access key (optional) ──────────────────────────────────────
# Lets an external monitor (uptime checker, status page) fetch the full
# per-service breakdown from /api/health by sending this value in the
# `x-health-access-key` header, without needing an admin session. Omit to
# disable that path entirely — unauthenticated callers still get {"status":...}.
HEALTH_CHECK_ACCESS_KEY=change-me-generate-a-real-secret

## ── OAUTH PROVIDERS (optional) ──────────────────────────────────────────────
# Uncomment and fill in both vars for a provider to activate it.
# Register apps at: https://github.com/settings/developers (GitHub)
#                   https://console.cloud.google.com/ (Google)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Public origin used by auth-client (scheme + host + port, no trailing slash)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

## ── APPLE WALLET PASSES ─────────────────────────────────────────────────────
# Pass signing certificates, each as a raw PEM or base64 of that PEM.
# SIGNER_KEY is a private key: keep it in a secret store, never in git.
APPLE_WALLET_WWDR_CERT=
APPLE_WALLET_SIGNER_CERT=
APPLE_WALLET_SIGNER_KEY=
# APPLE_WALLET_SIGNER_KEY_PASSPHRASE=

## ── CHECK-IN QR SIGNING ─────────────────────────────────────────────────────
# Ed25519 private key that signs every check-in QR code (Apple pass barcode,
# Google Wallet barcode, and the standalone QR) — asymmetric so a scanner can
# verify a code's authenticity offline from just the public key, with no
# server round-trip and no shared secret it could leak. Keep the private key
# in a secret store, never in git; paste as raw PEM or base64 of that PEM.
#
# Generate a keypair:
#   openssl genpkey -algorithm ed25519 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
CHECK_IN_SIGNING_PRIVATE_KEY=
# Optional — only for a verify-only deployment (e.g. an offline check-in
# scanner) that should never hold the private key. This app itself doesn't
# need it set: it derives the public key from CHECK_IN_SIGNING_PRIVATE_KEY
# above. Set from public.pem's contents; never the private key.
# CHECK_IN_SIGNING_PUBLIC_KEY=

## ── GOOGLE WALLET PASSES ────────────────────────────────────────────────────
# Numeric Issuer ID from the Google Wallet Business Console
# (pay.google.com/business/console).
GOOGLE_WALLET_ISSUER_ID=
# A GCP service account's client_email. The same account must be added as a
# "Developer" user on the issuer in the Business Console (Users tab) or API
# calls will be rejected even with a valid access token.
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
# That service account's private_key. Keep it in a secret store, never in
# git. Paste it as one line with literal \n sequences (as it appears in the
# downloaded JSON key) — they're converted to real newlines at runtime.
GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=

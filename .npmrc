# ── Supply-chain hardening ────────────────────────────────────
# Block lifecycle scripts by default (postinstall, preinstall, etc.)
# These are the #1 supply-chain attack vector. Packages that genuinely
# need build steps are allow-listed via pnpm.onlyBuiltDependencies
# in package.json.
ignore-scripts=true

# Include tarball URLs in the lockfile so installs can be verified
# against the exact archive that was originally resolved.
lockfile-include-tarball-url=true

# Prefer time-based resolution: when a range is first resolved, pnpm
# picks the latest version whose publish date is <= the latest version
# of the *direct* dependency that brought it in. This prevents
# transitive deps from pulling in brand-new releases before they've
# had community vetting.
resolution-mode=time-based
